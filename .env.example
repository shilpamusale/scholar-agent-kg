# ScholarAgent — environment template.
# Copy to .env and fill real values:  cp .env.example .env
# .env is gitignored; NEVER commit real credentials.

# --- Neo4j (knowledge graph) ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=please-change-me
NEO4J_URI=bolt://localhost:7687

# --- ChromaDB (RAG vector store) ---
# Embedded persistent client writes to this directory. No server required.
CHROMA_PERSIST_DIR=./.chroma

# --- Anthropic API (used from Phase 2 onward; not needed for the smoke test) ---
ANTHROPIC_API_KEY=
